# Puerto del servidor web
PORT=3000
MAX_FILE_MB=4

# Azure Document Intelligence (OCR)
DI_ENDPOINT=https://tu-servicio.cognitiveservices.azure.com/
DI_KEY=tu_azure_di_key_aqui
DI_API_VERSION=2024-11-30
